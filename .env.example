# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Admin IDs (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Database
# SQLite (default for local development):
DATABASE_URL=sqlite:///shop.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/shopbot

# Payment Provider (optional - for Telegram Payments)
PAYMENT_PROVIDER_TOKEN=

# Shop Settings
SHOP_NAME=My Shop
CURRENCY=USD
CURRENCY_SYMBOL=$

# Support
SUPPORT_CONTACT=@yoursupport
ORDER_NOTIFICATION_CHAT=  # Optional: Chat ID for order notifications
